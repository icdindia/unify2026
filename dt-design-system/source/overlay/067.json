utton {\n              width: 100%;\n              border: 0;\n              background: transparent;\n              color: inherit;\n              text-align: left;\n              font-family: inherit;\n              font-size: inherit;\n            }\n            #storybook-highlights-menu button:focus-visible {\n              outline-color: #029CFD;\n            }\n            #storybook-highlights-menu button:hover {\n              background: rgba(2, 156, 253, 0.07);\n              color: #029CFD;\n              cursor: pointer;\n            }\n            #storybook-highlights-menu li code {\n              white-space: nowrap;\n              overflow: hidden;\n              text-overflow: ellipsis;\n              line-height: 16px;\n              font-size: 11px;\n            }\n            #storybook-highlights-menu li svg {\n              flex-shrink: 0;\n              margin: 1px;\n              color: #73828C;\n            }\n            #storybook-highlights-menu li > button:hover svg, #storybook-highlights-menu li > button:focus-visible svg {\n              color: #029CFD;\n            }\n            #storybook-highlights-menu .element-list li svg {\n              display: none;\n            }\n            #storybook-highlights-menu li.selectable svg, #storybook-highlights-menu li.selected svg {\n              display: block;\n            }\n            #storybook-highlights-menu .menu-list {\n              border-top: 1px solid rgba(38, 85, 115, 0.15);\n            }\n            #storybook-highlights-menu .menu-list > li:not(:last-child) {\n              padding-bottom: 4px;\n              margin-bottom: 4px;\n              border-bottom: 1px solid rgba(38, 85, 115, 0.15);\n            }\n            #storybook-highlights-menu .menu-items, #storybook-highlights-menu .menu-items li {\n              padding: 0;\n            }\n            #storybook-highlights-menu .menu-item {\n              display: flex;\n            }\n            #storybook-highligh