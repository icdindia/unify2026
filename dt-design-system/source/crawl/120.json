/button><button type=\"button\" aria-label=\"Network Secure\" class=\"ODSSegments ODSSegments--size-large ODSSegments--variant-hug\" aria-pressed=\"false\" tabindex=\"-1\"><div class=\"ODSRow ODSSegments-ContentFrame ODSSegments-ContentFrame--size-large ODSSegments-ContentFrame--variant-hug ODSSegments-ContentFrame--type-primary\"><svg class=\"ODSIcon ODSSegments-Icon ODSSegments-Icon--size-large\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"false\" tabindex=\"-1\"><g fill=\"currentColor\"><g><path clip-rule=\"evenodd\" fill-rule=\"evenodd\" d=\"M12 2c-.768 0-1.524.253-2.097.79C9.32 3.334 9 4.104 9 4.985V7a3 3 0 0 0-3 3v3a3 3 0 0 0 3 3h2v2.265c-.305.176-.56.43-.736.735H5.732a2 2 0 1 0 0 2h4.532a2 2 0 0 0 3.465 0h4.539A2 2 0 0 0 22 20a2 2 0 0 0-3.732-1h-4.54a2 2 0 0 0-.728-.73V16h2a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3V4.986c0-.881-.32-1.651-.903-2.197C13.525 2.253 12.77 2 12 2m1 5V4.986c0-.382-.128-.604-.269-.736C12.58 4.108 12.336 4 12 4s-.58.108-.731.25c-.141.132-.269.354-.269.736V7zm2 7H9a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1\"></path></g></g></svg><span class=\"ODSSegments-Label ODSSegments-Label--size-large\">Network Secure</span></div></button></div></div></div>"}, {"id": "components-segmentedbutton--text-only", "name": "Text Only", "html": "<div><div style=\"min-width: 50rem; display: flex; flex-direction: column; align-items: center;\"><div class=\"ODSSegmentedButton ODSSegmentedButton--size-large ODSSegmentedButton--variant-hug\" role=\"group\"><button type=\"button\" aria-label=\"Label One\" class=\"ODSSegments ODSSegments--size-large ODSSegments--variant-hug\" aria-pressed=\"true\" tabindex=\"0\"><div class=\"ODSRow ODSSegments-ContentFrame ODSSegments-ContentFrame--selected ODSSegments-ContentFrame--size-large ODSSegments-ContentFrame--variant-hug ODSSegments-ContentFrame--type-primary\"><span class=\"ODSSegments-Label ODSSegments-Label--size-large ODSSegments-Label--selected\">Lab