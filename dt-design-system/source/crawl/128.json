up-LabelMax ODSSliderInputFieldGroup-LabelMax--variant-stacked\"><div class=\"ODSRow ODSSliderInputFieldGroup-Label ODSSliderInputFieldGroup-Label--variant-stacked\"><label class=\"ODSSliderInputFieldGroup-LabelMax-Text\" id=\"ODSSliderInputFieldGroup-LabelMax-Text-7jppst\">Label</label></div><div class=\"ODSRow ODSSliderInputField ODSSliderInputFieldGroup-SliderField ODSSliderInputFieldGroup-SliderField--variant-stacked\"><div class=\"ODSRow ODSSliderInputField-Content\"><div class=\"ODSRow ODSSliderInputField-InputValue\"><input tabindex=\"0\" class=\"ODSSliderInputField-Input ODSSliderInputField-Input--unstyled\" aria-labelledby=\"ODSSliderInputFieldGroup-LabelMax-Text-7jppst\" type=\"number\" value=\"100\"></div></div></div></div></div><div class=\"ODSColumn ODSSlider-TrackLabels\"><div class=\"ODSRow ODSSlider-TrackContainer\"><div class=\"ODSBox ODSSlider-Indicator\"></div><div class=\"ODSRow ODSSlider-Progress\" style=\"left: 0px; width: 880px;\"></div><div class=\"ODSBox ODSSlider-ThumbTrack\"><div class=\"ODSColumn ODSSliderHandle ODSSlider-SingleHandle ODSSlider-SingleHandle--type-twoHandles\" role=\"slider\" tabindex=\"0\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\" aria-label=\"Minimum value\" style=\"left: 0px;\"><div class=\"ODSColumn ODSSliderHandle-Handle\"></div><div class=\"ODSRow ODSSliderHandle-LabelContainer\"><span class=\"ODSSliderHandle-Label\">0</span></div></div><div class=\"ODSColumn ODSSliderHandle ODSSlider-RightHandle ODSSlider-RightHandle--type-twoHandles\" role=\"slider\" tabindex=\"-1\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"100\" aria-label=\"Maximum value\" style=\"left: 876px;\"><div class=\"ODSColumn ODSSliderHandle-Handle\"></div><div class=\"ODSRow ODSSliderHandle-LabelContainer\"><span class=\"ODSSliderHandle-Label\">100</span></div></div></div><div class=\"ODSBox ODSSlider-Indicator\"></div></div><div class=\"ODSRow ODSSlider-TrackLabelContainer\"><span class=\"ODSSlider-MinLabel\">0</span