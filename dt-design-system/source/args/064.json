{"rows": [{"name": "variant", "required": false, "description": "Used to define variant of actionSlot inside ODSDialogSheetPreferredActions", "type": "string", "default": ""}, {"name": "mainActionProps", "required": false, "description": "Used on mainAction inside ODSDialogSheetPreferredActions", "type": "object", "default": ""}, {"name": "secondaryActionProps", "required": false, "description": "Used on secondaryAction inside ODSDialogSheetPreferredActions", "type": "object", "default": ""}, {"name": "tertiaryActionProps", "required": false, "description": "Used on tertiaryAction inside ODSDialogSheetPreferredActions", "type": "object", "default": ""}, {"name": "headerText", "required": true, "description": "Heading for the dialog.", "type": "string", "default": ""}, {"name": "headingElement", "required": false, "description": "the heading element that will be used for the Dialog Title.", "type": "\"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\"", "default": "\"h2\""}, {"name": "contentSlot", "required": false, "description": "", "type": "ReactNode", "default": ""}, {"name": "actionSlot", "required": false, "description": "The dialog buttons action slot.", "type": "ReactNode", "default": ""}, {"name": "showCloseButton", "required": false, "description": "Whether the close button is displayed.", "type": "boolean", "default": "true"}, {"name": "closeButtonLabel", "required": false, "description": "Label for the close button for assistive technologies.", "type": "string", "default": "\"Close dialog\""}, {"name": "closeButtonProps", "required": false, "description": "Props for the close button (accessibility and behavior only, style is managed internally)", "type": "Omit<ODSButtonProps, \"className\" | \"size\" | \"buttonIcon\" | \"buttonType\" | \"variant\">", "default": ""}, {"name": "showTitle", "required": false, "description": "", "type": "boolean", "default": "true"}, {"name": "stickyButton", "required": false, "description": "Whether the action slot should be